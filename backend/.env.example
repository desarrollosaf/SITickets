# Plantilla de configuracion. Copiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env
# El archivo .env no se versiona: trae las credenciales del servidor.

PORT=3050

# ---------------------------------------------------------------------
# Servidor MySQL propio del area. El sistema NO levanta base de datos:
# se conecta a la que ya opera.
#
# DB_HOST segun donde este el servidor:
#   host.docker.internal  MySQL en esta misma maquina y el backend en Docker
#   localhost             MySQL en esta misma maquina y el backend con npm
#   10.0.0.25 / mysql.interno   servidor de red (pon su IP o su nombre)
# ---------------------------------------------------------------------
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=mesa_ayuda
DB_USER=mesa_app
DB_PASS=

# Crea o ajusta las tablas al arrancar, a partir de los modelos.
# En produccion va en false y el esquema se mueve con migraciones.
DB_SYNC=true

# Aplica los .sql de sql/migraciones al arrancar, una sola vez cada uno (lo
# aplicado queda anotado en la tabla `migracion`). Va en true tambien en
# produccion: es la unica via por la que se mueve el esquema ahi. Ponlo en
# false solo si el DBA prefiere correr los scripts a mano.
DB_MIGRAR=true

# Siembra catalogos y padron si la base esta vacia.
SEED_ON_BOOT=true
SEED_PASSWORD=

# Dominio de las cuentas institucionales. El campo «Cuenta de correo» del
# catalogo solo acepta correos de este dominio, y es el que usa la siembra para
# generar los correos del padron. Dejalo vacio para aceptar cualquier dominio.
CORREO_DOMINIO=congresoedomex.gob.mx

# ---------------------------------------------------------------------
# Sistema de bienes muebles. Surte el campo «No. de inventario» con los
# resguardos del usuario: el backend consulta {BIENES_API_URL}/{rfc}.
# Si no responde, la pantalla deja capturar el numero a mano.
# ---------------------------------------------------------------------
BIENES_API_URL=https://siasaf.gob.mx/bienes/api/getbienes
BIENES_API_TIMEOUT_MS=15000
# Solo si el servicio exige token; se manda como Authorization: Bearer
BIENES_API_TOKEN=

# Misma API, pero los tres endpoints que usa el servicio EQUIPO DE COMPUTO
# (consulta /bienes/{rfc}/1, ficha tecnica /bienesinfo/{id} y el movimiento
# /bienes/mantenimiento). Sin token: el acceso es por red confiable.
BIENES_API_BASE_URL=https://siasaf.gob.mx/bienes/api

# ---------------------------------------------------------------------
# Cuarta conexion: base del sistema "eService" (viejo, en PHP/Laravel).
# Ahi vive el catalogo real de impresoras arrendadas (tabla `impresoras`) y
# el historial de lecturas de tóner que manda el script Python por SNMP
# (tabla `comparacion_impre`). Lectura y escritura: los endpoints
# /pythonCompara y /pythonNotificaError insertan/actualizan ahi mismo.
# ---------------------------------------------------------------------
ESERVICE_DB_HOST=host.docker.internal
ESERVICE_DB_PORT=3306
ESERVICE_DB_NAME=eservice
ESERVICE_DB_USER=root
ESERVICE_DB_PASS=

# Clave fija que debe mandar el script Python en el header X-Api-Key al
# llamar /pythonCompara y /pythonNotificaError. No es un usuario con sesion,
# asi que no usa JWT — cambiala por algo largo y aleatorio en produccion.
PYTHON_TONER_API_KEY=

# Secreto de firma del token. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES=8h

CORS_ORIGIN=http://localhost:4200

# ---------------------------------------------------------------------
# Claude (Anthropic), solo para el boton "Mejorar redaccion" del dictamen de
# baja (reescribe la observacion del tecnico en formato tecnico formal).
# Genera tu key en https://console.anthropic.com. Sin esta variable el resto
# del sistema sigue funcionando igual; solo ese boton responde con error.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
